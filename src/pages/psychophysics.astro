---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Psychophysics — ${SITE_TITLE}`} description="Psychophysics experiments and demos." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Psychophysics</h1>
			<p>Interactive demonstrations of classic psychophysics experiments.</p>
			<ul class="task-list">
				<li><a href="/psychophysics/sternberg"><span class="task-name">Sternberg Memory Task</span> — how fast can you scan your short-term memory?</a></li>
				<li><a href="/psychophysics/shepard-metzler"><span class="task-name">Shepard-Metzler Mental Rotation</span> — how do you rotate objects in your mind?</a></li>
				<li><a href="/psychophysics/numerosity"><span class="task-name">Numerosity Discrimination</span> — measure your approximate number sense and Weber fraction.</a></li>
			</ul>
			<p class="external-note">
				<a href="https://bradylab.ucsd.edu/tcc/" target="_blank" rel="noopener">TCC demo (Brady Lab, UCSD)</a>
				— Not mine, but my current favorite way of describing visual short term memory.
			</p>
		</main>
		<Footer />
	</body>
</html>

<style>
	.task-list {
		list-style: none;
		padding: 0;
		margin-top: 2rem;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.task-list li {
		border: 1px solid var(--rule);
		border-radius: 2px;
		transition: border-color 0.2s;
	}
	.task-list li:hover {
		border-color: var(--accent);
	}
	.task-list a {
		display: block;
		padding: 1.25rem 1.5rem;
		font-family: var(--sans);
		font-size: 0.95rem;
		color: var(--fg-muted);
		font-weight: 400;
	}
	.task-list a:hover {
		text-decoration: none;
		color: var(--fg-muted);
	}
	.task-list .task-name {
		font-family: var(--serif);
		font-size: 1.1rem;
		color: var(--fg);
		font-weight: 500;
		display: block;
		margin-bottom: 0.25rem;
	}
	.task-list li:hover .task-name {
		color: var(--accent);
	}
	.external-note {
		margin-top: 2rem;
		font-size: 0.9rem;
		color: var(--fg-muted);
	}
</style>
