---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Mental Rotation — ${SITE_TITLE}`} description="The Shepard-Metzler mental rotation task." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Shepard-Metzler Mental Rotation</h1>
			<p>
				In 1971, Roger Shepard and Jacqueline Metzler ran an experiment on mental rotation. They showed people a 3D object and the same object after a rotation, and perhaps a reflection. 
				Response time for judging whether the two shapes are the same or mirror images increases linearly with the angle between them, as if the mind
				is literally turning one object to match the other. People typically rotate at about 60 degrees/second, and rotation rate weakly (r ≈ .25) correlates with IQ.
			</p>

			<p>
				Judge whether these shapes are the
				<strong>same shape</strong> or <strong>mirror images</strong>.
				Press <kbd>F</kbd> for same, <kbd>J</kbd> for mirror. On mobile, use the buttons.
			</p>
			<p class="attribution">
				Stimuli from Ganis, G. &amp; Kievit, R. (2015).
				<a href="https://openpsychologydata.metajnl.com/articles/10.5334/jopd.ai">A New Set of Three-Dimensional Shapes for Investigating Mental Rotation Processes</a>.
				<em>Journal of Open Psychology Data</em>, 3(1). CC BY 4.0.
			</p>

			<div id="task">
				<div id="screen-intro" class="screen">
					<div class="settings">
						<label>
							Total trials
							<input type="number" id="trial-count" value="30" min="5" max="100" />
						</label>
					</div>
					<button id="start-btn">Begin</button>
				</div>

				<div id="screen-trial" class="screen" hidden>
					<p id="trial-counter" class="counter"></p>
					<img id="stimulus-img" class="stimulus-img" alt="Mental rotation stimulus" />
					<p class="hint"><kbd>F</kbd> Same &emsp; <kbd>J</kbd> Mirror</p>
					<div class="response-buttons">
						<button id="btn-same" class="response-btn">Same</button>
						<button id="btn-mirror" class="response-btn secondary">Mirror</button>
					</div>
				</div>

				<div id="screen-results" class="screen" hidden>
					<p class="result-summary">Accuracy: <strong id="accuracy"></strong> &ensp; Trials: <strong id="total-trials"></strong></p>
					<p class="result-rotation">Rotation rate: <strong id="rotation-rate"></strong></p>
					<p class="result-note">Mean RT for correct "same" responses by rotation angle</p>
					<canvas id="rt-chart"></canvas>
					<div class="result-actions">
						<button id="more-btn">Run more trials</button>
						<button id="reset-btn">Start over</button>
					</div>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>

<style>
	kbd {
		font-family: var(--sans);
		font-size: 0.85rem;
		background: var(--rule);
		border: 1px solid var(--fg-muted);
		border-radius: 3px;
		padding: 2px 6px;
	}
	.attribution {
		font-size: 0.82rem;
		color: var(--fg-muted);
	}
	#task { margin-top: 2.5rem; }
	.screen {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 1.5rem;
	}
	.settings {
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.9rem;
		color: var(--fg-muted);
	}
	.settings label { display: flex; align-items: center; gap: 0.75rem; }
	.settings input {
		width: 70px;
		padding: 0.3rem 0.5rem;
		border: 1px solid var(--rule);
		border-radius: 2px;
		background: var(--bg);
		color: var(--fg);
		font-family: var(--sans);
		font-size: 0.9rem;
		text-align: center;
	}
	.counter {
		font-size: 0.85rem;
		color: var(--fg-muted);
		letter-spacing: 0.04em;
		margin: 0;
	}
	.stimulus-img {
		max-width: 100%;
		border: 1px solid var(--rule);
		border-radius: 2px;
		display: block;
	}
	.hint { font-size: 0.9rem; color: var(--fg-muted); margin: 0; }
	button {
		font-family: var(--sans);
		font-size: 0.85rem;
		font-weight: 500;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--accent);
		background: none;
		border: 1.5px solid var(--accent);
		border-radius: 2px;
		padding: 0.65rem 2rem;
		cursor: pointer;
		transition: background 0.2s, color 0.2s;
	}
	button:hover { background: var(--accent); color: var(--bg); }
	.response-buttons {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		justify-content: center;
	}
	.response-btn {
		padding: 0.9rem 2.5rem;
		font-size: 1rem;
		min-width: 130px;
		touch-action: manipulation;
	}
	.result-summary { font-size: 1rem; color: var(--fg-muted); margin: 0; }
	.result-rotation { font-size: 0.9rem; color: var(--fg-muted); margin: 0.3rem 0 0; }
	.result-note { font-size: 0.85rem; color: var(--fg-muted); margin: 1rem 0 0; }
	.result-actions { display: flex; gap: 1rem; margin-top: 1.5rem; }
	#rt-chart { max-width: 100%; }
	[hidden] { display: none !important; }
</style>

<script>
	const ANGLES = [0, 50, 100, 150];
	const N_OBJECTS = 48;
	const dpr = window.devicePixelRatio || 1;

	function imageUrl(obj: number, angle: number, type: 'same' | 'different'): string {
		return `/sm/${obj}_${angle}${type === 'different' ? '_R' : ''}.jpg`;
	}

	function getTrialCount(): number {
		return Math.max(5, Math.min(100, parseInt((document.getElementById('trial-count') as HTMLInputElement).value) || 30));
	}

	function buildTrials(n: number): { obj: number; angle: number; type: 'same' | 'different' }[] {
		const halfSame = Math.round(n / 2);
		const trials = Array.from({ length: n }, (_, i) => ({
			obj: Math.floor(Math.random() * N_OBJECTS) + 1,
			angle: ANGLES[Math.floor(Math.random() * ANGLES.length)],
			type: (i < halfSame ? 'same' : 'different') as 'same' | 'different',
		}));
		return trials.sort(() => Math.random() - 0.5);
	}

	let trials: { obj: number; angle: number; type: 'same' | 'different' }[] = [];
	let trialIndex = 0;
	let awaitingResponse = false;
	let probeStartTime = 0;
	let currentType: 'same' | 'different' = 'same';
	let currentAngle = 0;
	const allResults: { type: string; angle: number; RT: number; correct: boolean }[] = [];

	function showScreen(id: string) {
		document.querySelectorAll<HTMLElement>('.screen').forEach(el => el.hidden = true);
		document.getElementById(id)!.hidden = false;
	}

	function startTrial() {
		if (trialIndex >= trials.length) { showResults(); return; }
		const trial = trials[trialIndex];
		currentType = trial.type;
		currentAngle = trial.angle;

		document.getElementById('trial-counter')!.textContent =
			`Trial ${allResults.length + 1} of ${allResults.length + trials.length - trialIndex}`;

		const img = document.getElementById('stimulus-img') as HTMLImageElement;
		img.src = imageUrl(trial.obj, trial.angle, trial.type);

		img.onload = () => {
			probeStartTime = performance.now();
			awaitingResponse = true;
		};
	}

	function handleResponse(key: string) {
		if (!awaitingResponse) return;
		if (key !== 'f' && key !== 'j') return;
		awaitingResponse = false;
		const RT = performance.now() - probeStartTime;
		const response = key === 'f' ? 'same' : 'different';
		allResults.push({ type: currentType, angle: currentAngle, RT, correct: response === currentType });
		trialIndex++;
		setTimeout(startTrial, 150);
	}

	document.addEventListener('keydown', (e) => handleResponse(e.key.toLowerCase()));
	document.getElementById('btn-same')!.addEventListener('click', () => handleResponse('f'));
	document.getElementById('btn-mirror')!.addEventListener('click', () => handleResponse('j'));

	function startBatch() {
		trials = buildTrials(getTrialCount());
		trialIndex = 0;
		showScreen('screen-trial');
		startTrial();
	}

	document.getElementById('start-btn')!.addEventListener('click', startBatch);
	document.getElementById('more-btn')!.addEventListener('click', startBatch);
	document.getElementById('reset-btn')!.addEventListener('click', () => {
		allResults.length = 0;
		showScreen('screen-intro');
	});

	function computeRotationRate(): string {
		const points = ANGLES.map(a => {
			const ts = allResults.filter(r => r.type === 'same' && r.angle === a && r.correct);
			return ts.length ? { x: a, y: ts.reduce((s, r) => s + r.RT, 0) / ts.length } : null;
		}).filter((p): p is { x: number; y: number } => p !== null);

		if (points.length < 2) return 'insufficient data';

		const xBar = points.reduce((s, p) => s + p.x, 0) / points.length;
		const yBar = points.reduce((s, p) => s + p.y, 0) / points.length;
		const num = points.reduce((s, p) => s + (p.x - xBar) * (p.y - yBar), 0);
		const den = points.reduce((s, p) => s + (p.x - xBar) ** 2, 0);
		if (den === 0) return 'insufficient data';

		const slope = num / den;
		if (slope <= 0) return 'no clear trend yet — try more trials';
		return `${Math.round(1000 / slope)} °/sec (${Math.round(slope)} ms/°)`;
	}

	function showResults() {
		showScreen('screen-results');
		const correct = allResults.filter(r => r.correct).length;
		document.getElementById('accuracy')!.textContent = `${Math.round(correct / allResults.length * 100)}%`;
		document.getElementById('total-trials')!.textContent = String(allResults.length);
		document.getElementById('rotation-rate')!.textContent = computeRotationRate();
		drawChart();
	}

	function drawChart() {
		const canvas = document.getElementById('rt-chart') as HTMLCanvasElement;
		const W = 560, H = 360;
		canvas.style.width = W + 'px';
		canvas.style.height = H + 'px';
		canvas.width = W * dpr;
		canvas.height = H * dpr;
		const ctx = canvas.getContext('2d')!;
		ctx.scale(dpr, dpr);

		const pad = { top: 30, right: 40, bottom: 60, left: 80 };
		const cW = W - pad.left - pad.right;
		const cH = H - pad.top - pad.bottom;

		const means: Record<number, number | null> = {};
		ANGLES.forEach(angle => {
			const ts = allResults.filter(r => r.type === 'same' && r.angle === angle && r.correct);
			means[angle] = ts.length ? ts.reduce((a, b) => a + b.RT, 0) / ts.length : null;
		});

		const vals = Object.values(means).filter((v): v is number => v !== null);
		if (!vals.length) return;

		const minY = Math.min(...vals) * 0.85;
		const maxY = Math.max(...vals) * 1.12;
		const xPos = (a: number) => pad.left + a / 150 * cW;
		const yPos = (rt: number) => pad.top + cH - (rt - minY) / (maxY - minY) * cH;

		ctx.fillStyle = '#F6F3EE';
		ctx.fillRect(0, 0, W, H);

		for (let i = 0; i <= 4; i++) {
			const y = pad.top + i * cH / 4;
			ctx.strokeStyle = '#D6D1C9'; ctx.lineWidth = 1;
			ctx.beginPath(); ctx.moveTo(pad.left, y); ctx.lineTo(pad.left + cW, y); ctx.stroke();
			const rt = maxY - i * (maxY - minY) / 4;
			ctx.fillStyle = '#8A8680';
			ctx.font = '12px "Instrument Sans", system-ui, sans-serif';
			ctx.textAlign = 'right';
			ctx.fillText(Math.round(rt) + 'ms', pad.left - 8, y + 4);
		}

		ctx.fillStyle = '#8A8680';
		ctx.textAlign = 'center';
		ANGLES.forEach(a => ctx.fillText(a + '°', xPos(a), pad.top + cH + 20));
		ctx.fillText('Rotation angle', pad.left + cW / 2, pad.top + cH + 44);

		ctx.save();
		ctx.translate(18, pad.top + cH / 2);
		ctx.rotate(-Math.PI / 2);
		ctx.textAlign = 'center';
		ctx.fillText('Response time (ms)', 0, 0);
		ctx.restore();

		ctx.strokeStyle = '#D6D1C9'; ctx.lineWidth = 1;
		ctx.beginPath();
		ctx.moveTo(pad.left, pad.top); ctx.lineTo(pad.left, pad.top + cH);
		ctx.lineTo(pad.left + cW, pad.top + cH); ctx.stroke();

		ctx.strokeStyle = '#2D6A4F'; ctx.lineWidth = 2;
		let started = false;
		ctx.beginPath();
		ANGLES.forEach(a => {
			const v = means[a];
			if (v !== null) {
				started ? ctx.lineTo(xPos(a), yPos(v)) : ctx.moveTo(xPos(a), yPos(v));
				started = true;
			}
		});
		ctx.stroke();

		ANGLES.forEach(a => {
			const v = means[a];
			if (v !== null) {
				ctx.fillStyle = '#2D6A4F';
				ctx.beginPath();
				ctx.arc(xPos(a), yPos(v), 5, 0, Math.PI * 2);
				ctx.fill();
			}
		});
	}
</script>
