---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Links — ${SITE_TITLE}`} description="Links." />
	</head>
	<body>
		<Header />
		<main>
			<h1>Links</h1>

			<section class="link-section">
				<h2>Papers</h2>
				<ul class="link-list">
					<li>
						<a href="https://www.cell.com/cell-reports/pdfExtended/S2211-1247(22)00822-1" target="_blank" rel="noopener" class="link-title">Running speed and REM sleep control two distinct modes of rapid interhemispheric communication</a>
					</li>
					<li>
						<a href="https://www.nature.com/articles/s41593-023-01554-7" target="_blank" rel="noopener" class="link-title">A ubiquitous spectrolaminar motif of local field potential power across the primate cortex</a>
					</li>
					<li>
						<a href="https://pmc.ncbi.nlm.nih.gov/articles/PMC12302380/" target="_blank" rel="noopener" class="link-title">Cytoelectric coupling: Electric fields sculpt neural activity and 'tune' the brain's infrastructure</a>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Blogs</h2>
				<ul class="link-list">
					<li>
						<a href="https://www.astralcodexten.com/" target="_blank" rel="noopener" class="link-title">Astral Codex Ten</a>
					</li>
					<li>
						<a href="https://slatestarcodex.com/" target="_blank" rel="noopener" class="link-title">Slate Star Codex</a>
					</li>
					<li>
						<a href="https://universalprior.substack.com/" target="_blank" rel="noopener" class="link-title">Universal Prior</a>
					</li>
					<li>
						<a href="https://www.gleech.org/" target="_blank" rel="noopener" class="link-title">Gleech</a>
					</li>
					<li>
						<a href="https://sashachapin.substack.com/" target="_blank" rel="noopener" class="link-title">Sasha Chapin</a>
					</li>
					<li>
						<a href="https://usefulfictions.substack.com/" target="_blank" rel="noopener" class="link-title">Useful Fictions</a>
					</li>
					<li>
						<a href="https://aella.substack.com/" target="_blank" rel="noopener" class="link-title">Aella</a>
					</li>
					<li>
						<a href="https://niplav.site/" target="_blank" rel="noopener" class="link-title">niplav</a>
					</li>
					<li>
						<a href="https://smoothbrains.net/" target="_blank" rel="noopener" class="link-title">Smooth Brains</a>
					</li>
					<li>
						<a href="https://qualiacomputing.com/" target="_blank" rel="noopener" class="link-title">Qualia Computing</a>
					</li>
					<li>
						<a href="https://dynomight.net/" target="_blank" rel="noopener" class="link-title">Dynomight</a>
					</li>
					<li>
						<a href="https://neuroticgradientdescent.blogspot.com/" target="_blank" rel="noopener" class="link-title">Neurotic Gradient Descent</a>
					</li>
					<li>
						<a href="https://uli.rocks/about/" target="_blank" rel="noopener" class="link-title">uli.rocks</a>
					</li>
					<li>
						<a href="https://apxhard.substack.com/" target="_blank" rel="noopener" class="link-title">Approximately Hard</a>
					</li>
					<li>
						<a href="https://gwern.net/" target="_blank" rel="noopener" class="link-title">Gwern</a>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Meditation</h2>
				<ul class="link-list">
					<li>
						<a href="https://www.shinzen.org/" target="_blank" rel="noopener" class="link-title">Shinzen Young</a>
					</li>
					<li>
						<a href="https://www.mctb.org/wp-content/uploads/2021/09/MCTB2_Complete_PDF_Final.pdf" target="_blank" rel="noopener" class="link-title">Mastering the Core Teachings of the Buddha</a>
					</li>
					<li>
						<a href="https://archive.org/details/pathwithheartgui0000korn" target="_blank" rel="noopener" class="link-title">A Path with a Heart</a>
					</li>
					<li>
						<a href="https://awakeningdharma.org/" target="_blank" rel="noopener" class="link-title">Stephen Snyder</a>
					</li>
					<li>
						<a href="https://firekasina.org/" target="_blank" rel="noopener" class="link-title">Fire Kasina</a>
					</li>
					<li>
						<a href="https://www.rogerthisdell.com/" target="_blank" rel="noopener" class="link-title">Roger Thisdell</a>
					</li>
					<li>
						<a href="https://www.wystantbs.com/" target="_blank" rel="noopener" class="link-title">Wystan Bryant-Scott</a>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Wild Theories of Cognition</h2>
				<ul class="link-list">
					<li>
						<a href="https://www.ihes.fr/~gromov/wp-content/uploads/2018/08/ergobrain.pdf" target="_blank" rel="noopener" class="link-title">Ergobrain</a>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Writing</h2>
				<ul class="link-list">
					<li>
						<a href="https://www.lesswrong.com/posts/4basF9w9jaPZpoC8R/intro-to-brain-like-agi-safety-1-what-s-the-problem-and-why" target="_blank" rel="noopener" class="link-title">Intro to Brain-Like AGI Safety</a>
						<p class="link-desc">Steven Byrnes' model of the risks of AGI and a route to alignment. Of public models, his is the closest to mine that I know.</p>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Computing</h2>
				<ul class="link-list">
					<li>
						<a href="https://cpu.land/" target="_blank" rel="noopener" class="link-title">Putting the "You" in CPU</a>
					</li>
				</ul>
			</section>

			<section class="link-section">
				<h2>Math</h2>
				<ul class="link-list">
					<li>
						<a href="https://cgl.ethz.ch/Downloads/Publications/Papers/2020/Gun20b/Gun20b.pdf" target="_blank" rel="noopener" class="link-title">Intro to Vector Field Topology</a>
					</li>
					<li>
						<a href="https://minimalsurfaces.blog/page/2/" target="_blank" rel="noopener" class="link-title">Minimal Surfaces</a>
					</li>
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.link-section {
		margin-top: 2.5rem;
	}
	.link-section h2 {
		font-size: 0.8rem;
		font-weight: 500;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--fg-muted);
		margin-bottom: 1.25rem;
	}
	.link-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 1.5rem;
	}
	.link-list li {
		border-left: 2px solid var(--rule);
		padding-left: 1.25rem;
		transition: border-color 0.2s;
	}
	.link-list li:hover {
		border-color: var(--accent);
	}
	.link-title {
		font-family: var(--serif);
		font-size: 1.05rem;
		color: var(--fg);
		font-weight: 500;
	}
	.link-title:hover {
		color: var(--accent);
	}
	.link-desc {
		margin: 0.3rem 0 0;
		font-size: 0.9rem;
		color: var(--fg-muted);
	}
</style>
